# Copy to .env for local dev. Never commit the real file.

ANTHROPIC_API_KEY=

# Port the server listens on.
PORT=8787

# Optional: if set, /v1/parse requires this value in the x-openloop-client-key
# header. Not real access control (it ships inside the app bundle), just a
# speed bump against randoms hammering your Anthropic bill once this is
# deployed somewhere public. Leave unset for local dev.
CLIENT_SHARED_SECRET=
