# Copy to .env for local dev. Expo inlines EXPO_PUBLIC_* vars at build time —
# they are NOT secret (they ship inside the app bundle), so this only ever
# holds the parser server's URL, never ANTHROPIC_API_KEY (see server/.env.example).

# The parser server from server/ — e.g. http://192.168.1.10:8787 on a device,
# http://localhost:8787 on web. Leave unset to run local-parser-only.
EXPO_PUBLIC_AI_PARSER_URL=

# Only needed if the server has CLIENT_SHARED_SECRET set.
EXPO_PUBLIC_AI_PARSER_CLIENT_KEY=
